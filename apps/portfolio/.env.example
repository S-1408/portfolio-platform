# Copy to apps/portfolio/.env.local for local development.
# On Vercel, set these in the portfolio project's Environment Variables.

# --- Contact form (server-only; never prefix with NEXT_PUBLIC_) ---

# Resend API key (https://resend.com/api-keys).
# If unset, the contact form shows a friendly "email me directly" message
# instead of sending, so local dev works without credentials.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# Optional sender address. Must belong to a domain verified in Resend.
# Defaults to "Portfolio Contact <onboarding@resend.dev>", which Resend only
# delivers to the email address of the Resend account owner.
CONTACT_FROM_EMAIL=

# --- SEO (public, inlined at build time) ---

# Canonical origin used for metadataBase, canonical URLs, OG images, sitemap
# and robots.txt, e.g. https://sonamverma.dev. Falls back to Vercel's
# production domain (VERCEL_PROJECT_PRODUCTION_URL), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Multi-Zones (build time) ---

# Origin of the separately deployed blog zone, e.g. https://portfolio-blog.vercel.app
# When set, /blog, /blog/* and /blog-static/* are rewritten to it. Leave empty
# until the blog app exists.
BLOG_URL=

# --- Feature flags (public, inlined at build time) ---

# Show the Blog link in the header once the blog zone is deployed.
NEXT_PUBLIC_ENABLE_BLOG=false
